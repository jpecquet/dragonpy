\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces (a) Stroke-plane-normal (lift) component $C_{F^*_n}$ and (b) in-plane (drag) component $C_{F^*_s}$ of the force coefficient over the pitch plane at $\delta _0 = 90^\circ $. The force direction quadrant in the $(\hat  {s},\hat  {n})$ plane can be inferred from the signs.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cf_components}{{7}{11}{(a) Stroke-plane-normal (lift) component $C_{F^*_n}$ and (b) in-plane (drag) component $C_{F^*_s}$ of the force coefficient over the pitch plane at $\delta _0 = 90^\circ $. The force direction quadrant in the $(\hat {s},\hat {n})$ plane can be inferred from the signs}{figure.caption.8}{}}
