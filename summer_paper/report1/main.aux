\newlabel{fig:cf_components}{{7}{12}{(a) Stroke-plane-normal (lift) component $C_{F^*_n}$ and (b) in-plane (drag) component $C_{F^*_s}$ of the force coefficient over the pitch plane at $\delta _0 = 90^\circ $. The force direction quadrant in the $(\hat {s},\hat {n})$ plane can be inferred from the signs}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Dependence of $C_{F^*}$ on pitch parameters at zero body velocity over (a) the $(\delta _0,\psi _1)$ plane at $\psi _0 = 0$ and (b) the $(\psi _0, \psi _1)$ plane at $\delta _0 = 90^\circ $. Maximum shown as a white dot on both panels.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cf}{{8}{12}{Dependence of $C_{F^*}$ on pitch parameters at zero body velocity over (a) the $(\delta _0,\psi _1)$ plane at $\psi _0 = 0$ and (b) the $(\psi _0, \psi _1)$ plane at $\delta _0 = 90^\circ $. Maximum shown as a white dot on both panels}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Definition of the mean-force direction angle $\beta $. The mean force $\langle \vec  {F}^* \rangle = q^* \left ( C_{F^*_n} \hat  {n} + C_{F^*_s} \hat  {s} \right )$ is decomposed into its stroke-frame components (\autoref {eq:cfn}, \autoref {eq:cfs}). Here the positive mean pitch $\psi _0 > 0$ gives $C_{F^*_s} < 0$, so the force tilts counterclockwise off the normal and $\beta $ is positive. The wing is drawn over one full wingbeat.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{fig:beta-def}{{9}{13}{Definition of the mean-force direction angle $\beta $. The mean force $\langle \vec {F}^* \rangle = q^* \left ( C_{F^*_n} \hat {n} + C_{F^*_s} \hat {s} \right )$ is decomposed into its stroke-frame components (\autoref {eq:cfn}, \autoref {eq:cfs}). Here the positive mean pitch $\psi _0 > 0$ gives $C_{F^*_s} < 0$, so the force tilts counterclockwise off the normal and $\beta $ is positive. The wing is drawn over one full wingbeat}{figure.caption.10}{}}
\newlabel{eq:beta}{{43}{13}{Hover Case $(J=0)$}{equation.43}{}}
\newlabel{eq:beta-hover}{{49}{13}{Hover Case $(J=0)$}{equation.49}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Effect of $\psi _0$ on force direction angle $\beta $ and force coefficient $C_{F^*}$.}}{14}{figure.caption.11}\protected@file@percent }
