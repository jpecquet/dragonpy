\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Pitch amplitude $\psi _1^\text  {opt}$ and force coefficient $C_{F^*}$ of the continued hover optimum (the point tracked in \autoref {fig:cf_J}) as functions of advance ratio $J$. The dashed line is the approximation $\psi _1^\text  {opt}(0) - \tan ^{-1} J$, which holds the midstroke $\alpha $ constant as $J$ increases. }}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:hover_opt_J}{{12}{18}{Pitch amplitude $\psi _1^\text {opt}$ and force coefficient $C_{F^*}$ of the continued hover optimum (the point tracked in \autoref {fig:cf_J}) as functions of advance ratio $J$. The dashed line is the approximation $\psi _1^\text {opt}(0) - \tan ^{-1} J$, which holds the midstroke $\alpha $ constant as $J$ increases}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Effect of $\psi _0$ on the force direction angle $\beta $ for increasing advance ratio $J$, at $\delta _0 = 90^\circ $ and with $\psi _1 = \psi _1^\text  {opt}(J)$. Unlike in the hover case, $\beta $ depends on $\psi _1$ when $J > 0$.}}{18}{figure.caption.15}\protected@file@percent }
\newlabel{fig:beta_vs_psi0_J}{{13}{18}{Effect of $\psi _0$ on the force direction angle $\beta $ for increasing advance ratio $J$, at $\delta _0 = 90^\circ $ and with $\psi _1 = \psi _1^\text {opt}(J)$. Unlike in the hover case, $\beta $ depends on $\psi _1$ when $J > 0$}{figure.caption.15}{}}
