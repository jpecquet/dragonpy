\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Hover hold with position feedback only ($K_d = 0$). The oscillation about $\vec  {x}^*_r$ is not damped, and the phase lag of the once-per-wingbeat control update makes it grow. Once the position error exceeds the hover pin radius, $\gamma $ and $\psi _1$ resume scheduling and the trim saturates.}}{24}{figure.caption.18}\protected@file@percent }
\newlabel{fig:hover-kp}{{14}{24}{Hover hold with position feedback only ($K_d = 0$). The oscillation about $\vec {x}^*_r$ is not damped, and the phase lag of the once-per-wingbeat control update makes it grow. Once the position error exceeds the hover pin radius, $\gamma $ and $\psi _1$ resume scheduling and the trim saturates}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Hover hold with velocity feedback only ($K_p = 0$). The velocity perturbation is eliminated within about one time unit, but the position offset accumulated meanwhile (about $0.05$ body lengths) is never corrected. With that said, the resulting error is very small, and while there is some residual drift over time, the result is quite satisfactory.}}{25}{figure.caption.19}\protected@file@percent }
\newlabel{fig:hover-kd}{{15}{25}{Hover hold with velocity feedback only ($K_p = 0$). The velocity perturbation is eliminated within about one time unit, but the position offset accumulated meanwhile (about $0.05$ body lengths) is never corrected. With that said, the resulting error is very small, and while there is some residual drift over time, the result is quite satisfactory}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Hover hold with the full tracking law. The body returns to $\vec  {x}^*_r$ (peak excursion $0.06$ body lengths, residual position error below $2 \times 10^{-3}$).}}{26}{figure.caption.20}\protected@file@percent }
\newlabel{fig:hover-kpkd}{{16}{26}{Hover hold with the full tracking law. The body returns to $\vec {x}^*_r$ (peak excursion $0.06$ body lengths, residual position error below $2 \times 10^{-3}$)}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Prescribed trajectory with position feedback only ($K_d = 0$): as in hover, the undamped error dynamics under the once-per-wingbeat update are unstable, and the body departs from the path.}}{27}{figure.caption.21}\protected@file@percent }
\newlabel{fig:traj-kp}{{17}{27}{Prescribed trajectory with position feedback only ($K_d = 0$): as in hover, the undamped error dynamics under the once-per-wingbeat update are unstable, and the body departs from the path}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Prescribed trajectory with velocity feedback only ($K_p = 0$): the body follows the commanded velocity with a first-order lag, trailing the reference by $|\vec  {u}^*_r| / K_d \approx 0.26$ body lengths throughout. The deceleration ramp lets it catch up near the end, but nothing corrects position drift. With that said, the resulting trajectory appears very satisfactory.}}{28}{figure.caption.22}\protected@file@percent }
\newlabel{fig:traj-kd}{{18}{28}{Prescribed trajectory with velocity feedback only ($K_p = 0$): the body follows the commanded velocity with a first-order lag, trailing the reference by $|\vec {u}^*_r| / K_d \approx 0.26$ body lengths throughout. The deceleration ramp lets it catch up near the end, but nothing corrects position drift. With that said, the resulting trajectory appears very satisfactory}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Prescribed trajectory with position and velocity feedback ($K_p + K_d$, no feedforward). Tracking error peaks at $0.25$ body lengths, dominated by the speed-ramp lag and by the ``cutting'' inside the arc, since the required acceleration must be generated by a standing error.}}{29}{figure.caption.23}\protected@file@percent }
\newlabel{fig:traj-kpkd}{{19}{29}{Prescribed trajectory with position and velocity feedback ($K_p + K_d$, no feedforward). Tracking error peaks at $0.25$ body lengths, dominated by the speed-ramp lag and by the ``cutting'' inside the arc, since the required acceleration must be generated by a standing error}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Prescribed trajectory with the full law of \autoref {eq:fdes}, including the acceleration feedforward $\vec  {a}^*_r$. The maneuver demand is supplied directly rather than through the error terms, and the peak tracking error drops significantly.}}{30}{figure.caption.24}\protected@file@percent }
\newlabel{fig:traj-ff}{{20}{30}{Prescribed trajectory with the full law of \autoref {eq:fdes}, including the acceleration feedforward $\vec {a}^*_r$. The maneuver demand is supplied directly rather than through the error terms, and the peak tracking error drops significantly}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Prey pursuit. (a) The line-of-sight command produces the classical pure-pursuit tail chase, with capture at $t^* \approx 7.5$ (star). (b) The body accelerates to the commanded closing speed ($J \approx 0.2$). $\gamma $ leans from $\gamma ^\text  {hover}$ toward alignment with the flight direction, $\psi _1$ follows its slaved schedule (\autoref {eq:psi1-slave}), and $(s_0^*, \psi _0)$ trim the force demand.}}{31}{figure.caption.25}\protected@file@percent }
\newlabel{fig:pursuit}{{21}{31}{Prey pursuit. (a) The line-of-sight command produces the classical pure-pursuit tail chase, with capture at $t^* \approx 7.5$ (star). (b) The body accelerates to the commanded closing speed ($J \approx 0.2$). $\gamma $ leans from $\gamma ^\text {hover}$ toward alignment with the flight direction, $\psi _1$ follows its slaved schedule (\autoref {eq:psi1-slave}), and $(s_0^*, \psi _0)$ trim the force demand}{figure.caption.25}{}}
