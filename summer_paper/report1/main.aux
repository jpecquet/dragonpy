\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Control law geometry in the hover use case. The reference velocity is zero and therefore not drawn. The force demand of \autoref {eq:fdes} adds up the weight compensation $\hat  {z}$ with the braking term $-K \vec  {u}^*$ opposing the residual drift velocity $\vec  {u}^*$, giving a resultant that supports the weight while arresting the drift. The stroke plane is fixed at $\gamma = \gamma ^\text  {hover}$ and $\psi _1 = \psi _1^\text  {opt}(J=0)$.}}{21}{figure.caption.18}\protected@file@percent }
\newlabel{fig:hover-diagram}{{15}{21}{Control law geometry in the hover use case. The reference velocity is zero and therefore not drawn. The force demand of \autoref {eq:fdes} adds up the weight compensation $\hat {z}$ with the braking term $-K \vec {u}^*$ opposing the residual drift velocity $\vec {u}^*$, giving a resultant that supports the weight while arresting the drift. The stroke plane is fixed at $\gamma = \gamma ^\text {hover}$ and $\psi _1 = \psi _1^\text {opt}(J=0)$}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.4.2}Gain Discussion}{21}{subsubsection.3.4.2}\protected@file@percent }
\newlabel{eq:discrete-map}{{74}{21}{Gain Discussion}{equation.74}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Control law geometry in the prescribed-trajectory use case. The reference point (blue dot) travels along the prescribed path (blue curve). The body is not constrained to the path since there is no position feedback, so its own path (in orange) does not line up exactly. The path velocity $\vec  {u}^*_r$ shown in blue and the body velocity $\vec  {u}^*$ give the error term $\vec  {u}^*_r - \vec  {u}^*$, and the force demand of \autoref {eq:fdes} adds up the weight compensation $\hat  {z}$ with the amplified error $K (\vec  {u}^*_r - \vec  {u}^*)$.}}{22}{figure.caption.19}\protected@file@percent }
\newlabel{fig:trajectory-diagram}{{16}{22}{Control law geometry in the prescribed-trajectory use case. The reference point (blue dot) travels along the prescribed path (blue curve). The body is not constrained to the path since there is no position feedback, so its own path (in orange) does not line up exactly. The path velocity $\vec {u}^*_r$ shown in blue and the body velocity $\vec {u}^*$ give the error term $\vec {u}^*_r - \vec {u}^*$, and the force demand of \autoref {eq:fdes} adds up the weight compensation $\hat {z}$ with the amplified error $K (\vec {u}^*_r - \vec {u}^*)$}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Control law geometry in the prey pursuit use case. The prey is detected at the line-of-sight bearing $\hat  {r}$ (sparse dots), and the reference velocity defined as $\vec  {u}^*_r = u^*_\text  {cmd}\,\hat  {r}$ (\autoref {eq:ur-pursuit}) points along it. The control law attempts to correct the velocity error $\vec  {u}^*_r - \vec  {u}^*$ to maintain the pursuit course. The force demand of \autoref {eq:fdes} adds up the weight compensation $\hat  {z}$ with the amplified error $K (\vec  {u}^*_r - \vec  {u}^*)$. The prey position $\vec  {x}^*_\text  {prey}$ enters the control law only to obtain $\hat  {r}$, with all range information discarded. The prey velocity $\vec  {u}^*_\text  {prey}$ never enters the control law. }}{22}{figure.caption.20}\protected@file@percent }
\newlabel{fig:pursuit-diagram}{{17}{22}{Control law geometry in the prey pursuit use case. The prey is detected at the line-of-sight bearing $\hat {r}$ (sparse dots), and the reference velocity defined as $\vec {u}^*_r = u^*_\text {cmd}\,\hat {r}$ (\autoref {eq:ur-pursuit}) points along it. The control law attempts to correct the velocity error $\vec {u}^*_r - \vec {u}^*$ to maintain the pursuit course. The force demand of \autoref {eq:fdes} adds up the weight compensation $\hat {z}$ with the amplified error $K (\vec {u}^*_r - \vec {u}^*)$. The prey position $\vec {x}^*_\text {prey}$ enters the control law only to obtain $\hat {r}$, with all range information discarded. The prey velocity $\vec {u}^*_\text {prey}$ never enters the control law}{figure.caption.20}{}}
