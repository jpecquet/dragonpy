\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Stroke-frame velocity decomposition and flow angle. With the body velocity assumed normal to the stroke plane, the instantaneous wing velocity $\vec  {v}^*$ has an in-plane flapping component $v_s^*\,\hat  {s}$ and a normal component $\langle u^* \rangle \,\hat  {n}$. The pitch angle $\psi $ and the flow angle $\chi $ are measured from $\hat  {n}$ with the same signed sense (positive when tilting toward $-\hat  {s}$), and locate the chord direction $\hat  {c}$ and the velocity direction $\hat  {v}$, respectively, so the angle of attack is $\alpha = \psi - \chi $. As drawn, both $\psi $ and $\chi $ are negative.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:flow-angles}{{5}{9}{Stroke-frame velocity decomposition and flow angle. With the body velocity assumed normal to the stroke plane, the instantaneous wing velocity $\vec {v}^*$ has an in-plane flapping component $v_s^*\,\hat {s}$ and a normal component $\langle u^* \rangle \,\hat {n}$. The pitch angle $\psi $ and the flow angle $\chi $ are measured from $\hat {n}$ with the same signed sense (positive when tilting toward $-\hat {s}$), and locate the chord direction $\hat {c}$ and the velocity direction $\hat {v}$, respectively, so the angle of attack is $\alpha = \psi - \chi $. As drawn, both $\psi $ and $\chi $ are negative}{figure.caption.6}{}}
\newlabel{eq:v_sq}{{30}{9}{Definitions and Assumptions}{equation.30}{}}
\newlabel{eq:alpha}{{32}{9}{Definitions and Assumptions}{equation.32}{}}
