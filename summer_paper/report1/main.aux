\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Stroke-frame velocity decomposition and flow angle. With the body velocity assumed normal to the stroke plane, the instantaneous wing velocity $\vec  {v}^*$ composes the in-plane flapping component $v_s^*\,\hat  {s}$ with the normal component $\langle u^* \rangle \,\hat  {n}$. The pitch angle $\psi $ and the flow angle $\chi $ are measured from $\hat  {n}$ with the same signed sense (positive tilting toward $-\hat  {s}$), locating the chord direction $\hat  {c}$ and the velocity direction $\hat  {v}$, so the angle of attack is $\alpha = \psi - \chi $. Drawn on the $+\hat  {s}$ half-stroke ($\sin \tau ^* < 0$), where both $\psi $ and $\chi $ are negative.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:flow-angles}{{5}{9}{Stroke-frame velocity decomposition and flow angle. With the body velocity assumed normal to the stroke plane, the instantaneous wing velocity $\vec {v}^*$ composes the in-plane flapping component $v_s^*\,\hat {s}$ with the normal component $\langle u^* \rangle \,\hat {n}$. The pitch angle $\psi $ and the flow angle $\chi $ are measured from $\hat {n}$ with the same signed sense (positive tilting toward $-\hat {s}$), locating the chord direction $\hat {c}$ and the velocity direction $\hat {v}$, so the angle of attack is $\alpha = \psi - \chi $. Drawn on the $+\hat {s}$ half-stroke ($\sin \tau ^* < 0$), where both $\psi $ and $\chi $ are negative}{figure.caption.6}{}}
\newlabel{eq:v_sq}{{30}{9}{Definitions and Assumptions}{equation.30}{}}
\newlabel{eq:alpha}{{32}{9}{Definitions and Assumptions}{equation.32}{}}
