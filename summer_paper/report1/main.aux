\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Force coefficient $C_{F^*}$ over the pitch plane $(\psi _0, \psi _1)$ at $\delta _0 = 90^\circ $, for increasing advance ratio $J$. White dots track the hover optimum as it moves with $J$. It remains on the $\psi _0 = 0^\circ $ axis by symmetry while $\psi _1$ decreases, and it turns from a local maximum into a saddle point. The global maximum sits at large $|\psi _0|$, where the force is dominated by drag from the normal inflow and points along $-\hat  {n}$. The dotted contour marks $C_{F^*_n} = 0$, the boundary between propulsive ($+\hat  {n}$) and braking ($-\hat  {n}$) mean force.}}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cf_J}{{12}{18}{Force coefficient $C_{F^*}$ over the pitch plane $(\psi _0, \psi _1)$ at $\delta _0 = 90^\circ $, for increasing advance ratio $J$. White dots track the hover optimum as it moves with $J$. It remains on the $\psi _0 = 0^\circ $ axis by symmetry while $\psi _1$ decreases, and it turns from a local maximum into a saddle point. The global maximum sits at large $|\psi _0|$, where the force is dominated by drag from the normal inflow and points along $-\hat {n}$. The dotted contour marks $C_{F^*_n} = 0$, the boundary between propulsive ($+\hat {n}$) and braking ($-\hat {n}$) mean force}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Pitch amplitude $\psi _1^\text  {opt}$ and force coefficient $C_{F^*}$ of the continued hover optimum (the point tracked in \autoref {fig:cf_J}) as functions of advance ratio $J$. The dashed line is the approximation $\psi _1^\text  {opt}(0) - \tan ^{-1} J$, which holds the midstroke $\alpha $ constant as $J$ increases. }}{19}{figure.caption.15}\protected@file@percent }
\newlabel{fig:hover_opt_J}{{13}{19}{Pitch amplitude $\psi _1^\text {opt}$ and force coefficient $C_{F^*}$ of the continued hover optimum (the point tracked in \autoref {fig:cf_J}) as functions of advance ratio $J$. The dashed line is the approximation $\psi _1^\text {opt}(0) - \tan ^{-1} J$, which holds the midstroke $\alpha $ constant as $J$ increases}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Effect of $\psi _0$ on the force direction angle $\beta $ for increasing advance ratio $J$, at $\delta _0 = 90^\circ $ and with $\psi _1 = \psi _1^\text  {opt}(J)$. Unlike in the hover case, $\beta $ depends on $\psi _1$ when $J > 0$.}}{19}{figure.caption.16}\protected@file@percent }
\newlabel{fig:beta_vs_psi0_J}{{14}{19}{Effect of $\psi _0$ on the force direction angle $\beta $ for increasing advance ratio $J$, at $\delta _0 = 90^\circ $ and with $\psi _1 = \psi _1^\text {opt}(J)$. Unlike in the hover case, $\beta $ depends on $\psi _1$ when $J > 0$}{figure.caption.16}{}}
