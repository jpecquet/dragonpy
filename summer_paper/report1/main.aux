\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:model-geometry}{{1}{3}{Model geometry. The stroke basis $(\hat {s},\hat {n})$ is obtained by rotating the fixed frame basis $(\hat {x},\hat {z})$ by the stroke plane angle $\gamma $. The wing element sits at position $s(t)\,\hat {s}$ relative to the point mass body, with chord direction $\hat {c}$ at pitch angle $\psi $ from the stroke plane normal $\hat {n}$. For simplicity, only one wing element is drawn}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Lift and drag directions in the four quadrants of the angle of attack $\alpha $, measured from the wing velocity direction $\hat  {v}$ to the chord direction $\hat  {c}$. Panels are labeled by quadrant (I--IV). Drag ($C_D > 0$) always opposes the wing velocity along $\hat  {d}$, while the sign of $C_L$ orients lift along $\pm \hat  {\ell }$. The hollow circle marks the wing leading edge (the $\hat  {c}$ end of the chord).}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:liftdrag-quadrants}{{2}{4}{Lift and drag directions in the four quadrants of the angle of attack $\alpha $, measured from the wing velocity direction $\hat {v}$ to the chord direction $\hat {c}$. Panels are labeled by quadrant (I--IV). Drag ($C_D > 0$) always opposes the wing velocity along $\hat {d}$, while the sign of $C_L$ orients lift along $\pm \hat {\ell }$. The hollow circle marks the wing leading edge (the $\hat {c}$ end of the chord)}{figure.caption.3}{}}
