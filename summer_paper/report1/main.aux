\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Stroke plane tilting (\autoref {eq:gamma-schedule}) in level flight toward $+\hat  {x}$ ($\sigma _x = +1$), at increasing advance ratio. At rest (left), the stroke plane holds the hover stroke plane angle $\sigma _x \gamma ^\text  {hover}$. As the forward speed builds (middle, right), the stroke plane tilts towards the velocity-aligned value $\gamma _u$, at which the stroke-plane normal $\hat  {n}$ points along the flight direction and the inflow is axial.}}{24}{figure.caption.21}\protected@file@percent }
\newlabel{fig:gamma-schedule-level}{{18}{24}{Stroke plane tilting (\autoref {eq:gamma-schedule}) in level flight toward $+\hat {x}$ ($\sigma _x = +1$), at increasing advance ratio. At rest (left), the stroke plane holds the hover stroke plane angle $\sigma _x \gamma ^\text {hover}$. As the forward speed builds (middle, right), the stroke plane tilts towards the velocity-aligned value $\gamma _u$, at which the stroke-plane normal $\hat {n}$ points along the flight direction and the inflow is axial}{figure.caption.21}{}}
