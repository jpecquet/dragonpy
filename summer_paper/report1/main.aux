\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Hover control with initial velocity perturbation at $K T^* = 1$. The velocity perturbation is eliminated within about one time unit. The small position offset accumulated meanwhile is never corrected since there is no position feedback, and some slow residual drift remains, but the body settles into a clean hover about the settled point.}}{26}{figure.caption.22}\protected@file@percent }
\newlabel{fig:hover}{{19}{26}{Hover control with initial velocity perturbation at $K T^* = 1$. The velocity perturbation is eliminated within about one time unit. The small position offset accumulated meanwhile is never corrected since there is no position feedback, and some slow residual drift remains, but the body settles into a clean hover about the settled point}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Prescribed trajectory under the velocity law ($K T^* = 1$): the body follows the commanded velocity with a first-order lag, trailing the reference point by $|\vec  {u}^*_r| / K \approx 0.22$ body lengths through the cruise and cutting slightly inside the sharp corners, with the tracking error peaking at $0.34$. Position drift is not corrected, but the achieved path stays close to the course throughout---including the loop and the descent---and the body settles next to the course endpoint (final offset $0.06$).}}{27}{figure.caption.23}\protected@file@percent }
\newlabel{fig:traj}{{20}{27}{Prescribed trajectory under the velocity law ($K T^* = 1$): the body follows the commanded velocity with a first-order lag, trailing the reference point by $|\vec {u}^*_r| / K \approx 0.22$ body lengths through the cruise and cutting slightly inside the sharp corners, with the tracking error peaking at $0.34$. Position drift is not corrected, but the achieved path stays close to the course throughout---including the loop and the descent---and the body settles next to the course endpoint (final offset $0.06$)}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Freehand trajectory with $K T^* = 1$ and cruise speed $0.35$.}}{28}{figure.caption.24}\protected@file@percent }
\newlabel{fig:traj-drawn}{{21}{28}{Freehand trajectory with $K T^* = 1$ and cruise speed $0.35$}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Prey pursuit. (a) The line-of-sight command produces the classical pure-pursuit tail chase, with capture at $t^* \approx 7.7$ (star). (b) The body accelerates to the commanded closing speed ($J \approx 0.2$). $\gamma $ leans from $\gamma ^\text  {hover}$ toward alignment with the flight direction, $\psi _1$ follows its slaved schedule (\autoref {eq:psi1-slave}), and $(s_0^*, \psi _0)$ trim the force demand.}}{29}{figure.caption.25}\protected@file@percent }
\newlabel{fig:pursuit}{{22}{29}{Prey pursuit. (a) The line-of-sight command produces the classical pure-pursuit tail chase, with capture at $t^* \approx 7.7$ (star). (b) The body accelerates to the commanded closing speed ($J \approx 0.2$). $\gamma $ leans from $\gamma ^\text {hover}$ toward alignment with the flight direction, $\psi _1$ follows its slaved schedule (\autoref {eq:psi1-slave}), and $(s_0^*, \psi _0)$ trim the force demand}{figure.caption.25}{}}
