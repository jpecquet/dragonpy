\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Force coefficient $C_{F^*}$ over the pitch plane $(\psi _0, \psi _1)$ at $\delta _0 = 90^\circ $, for increasing advance ratio $J$. White dots track the hover optimum as it moves with $J$. It remains on the $\psi _0 = 0^\circ $ axis by symmetry while $\psi _1$ decreases, and it turns from a local maximum into a saddle point. The global maximum sits at large $|\psi _0|$, where the force is dominated by drag from the normal inflow and points along $-\hat  {n}$. The dotted contour marks $C_{F^*_n} = 0$, the boundary between propulsive ($+\hat  {n}$) and braking ($-\hat  {n}$) mean force.}}{12}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cf_J}{{5}{12}{Force coefficient $C_{F^*}$ over the pitch plane $(\psi _0, \psi _1)$ at $\delta _0 = 90^\circ $, for increasing advance ratio $J$. White dots track the hover optimum as it moves with $J$. It remains on the $\psi _0 = 0^\circ $ axis by symmetry while $\psi _1$ decreases, and it turns from a local maximum into a saddle point. The global maximum sits at large $|\psi _0|$, where the force is dominated by drag from the normal inflow and points along $-\hat {n}$. The dotted contour marks $C_{F^*_n} = 0$, the boundary between propulsive ($+\hat {n}$) and braking ($-\hat {n}$) mean force}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Pitch amplitude $\psi _1$ and force coefficient $C_{F^*}$ of the continued hover optimum (the point tracked in \autoref {fig:cf_J}) as functions of advance ratio $J$. The point turns from a local maximum into a saddle at $J \approx 0.46$.}}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:hover_opt_J}{{6}{13}{Pitch amplitude $\psi _1$ and force coefficient $C_{F^*}$ of the continued hover optimum (the point tracked in \autoref {fig:cf_J}) as functions of advance ratio $J$. The point turns from a local maximum into a saddle at $J \approx 0.46$}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Illustration of the $\psi $ reduction mechanism for maximizing stroke-plane-normal force as $J$ increases.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:psi1-decrease}{{7}{13}{Illustration of the $\psi $ reduction mechanism for maximizing stroke-plane-normal force as $J$ increases}{figure.caption.9}{}}
