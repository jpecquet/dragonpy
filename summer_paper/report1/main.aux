\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Control-law geometry in the hover use case. The reference velocity is zero (and therefore not drawn): the force demand of \autoref {eq:fdes} composes, tip to tail, the weight compensation $\hat  {z}$ with the braking term $-K \vec  {u}^*$ opposing the residual drift velocity $\vec  {u}^*$, giving a resultant that supports the weight while arresting the drift. The stroke plane is pinned at $\gamma = \gamma ^\text  {hover} = -45^\circ $ with $\psi _1 = \psi _1^\text  {opt}(0)$; wingbeat overlay as in \autoref {fig:hover-beta-gamma}, arrow lengths schematic.}}{24}{figure.caption.19}\protected@file@percent }
\newlabel{fig:hover-diagram}{{15}{24}{Control-law geometry in the hover use case. The reference velocity is zero (and therefore not drawn): the force demand of \autoref {eq:fdes} composes, tip to tail, the weight compensation $\hat {z}$ with the braking term $-K \vec {u}^*$ opposing the residual drift velocity $\vec {u}^*$, giving a resultant that supports the weight while arresting the drift. The stroke plane is pinned at $\gamma = \gamma ^\text {hover} = -45^\circ $ with $\psi _1 = \psi _1^\text {opt}(0)$; wingbeat overlay as in \autoref {fig:hover-beta-gamma}, arrow lengths schematic}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Control-law geometry in the prescribed-trajectory use case. The reference point (dot) travels along the prescribed path (in color, solid where already traveled, dashed ahead) with velocity $\vec  {u}^*_r$, the path tangent scaled by the speed schedule. The body is not constrained to the path: with no position feedback it trails the reference, cutting slightly inside the bend, and its velocity $\vec  {u}^*$ lags the leveling-off of the path. The reference velocity is copied at the body (in color) to close the velocity triangle, and the force demand of \autoref {eq:fdes} composes, tip to tail, the weight compensation $\hat  {z}$ with the amplified error $K (\vec  {u}^*_r - \vec  {u}^*)$. Wingbeat overlay as in \autoref {fig:pursuit-diagram}, at the blended stroke-plane angle for the drawn $J \approx 0.2$; arrow lengths are schematic.}}{24}{figure.caption.20}\protected@file@percent }
\newlabel{fig:trajectory-diagram}{{16}{24}{Control-law geometry in the prescribed-trajectory use case. The reference point (dot) travels along the prescribed path (in color, solid where already traveled, dashed ahead) with velocity $\vec {u}^*_r$, the path tangent scaled by the speed schedule. The body is not constrained to the path: with no position feedback it trails the reference, cutting slightly inside the bend, and its velocity $\vec {u}^*$ lags the leveling-off of the path. The reference velocity is copied at the body (in color) to close the velocity triangle, and the force demand of \autoref {eq:fdes} composes, tip to tail, the weight compensation $\hat {z}$ with the amplified error $K (\vec {u}^*_r - \vec {u}^*)$. Wingbeat overlay as in \autoref {fig:pursuit-diagram}, at the blended stroke-plane angle for the drawn $J \approx 0.2$; arrow lengths are schematic}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Control-law geometry in the prey pursuit use case. The prey is detected at the line-of-sight bearing $\hat  {r}$ (sparse dots), and the reference velocity $\vec  {u}^*_r = u^*_\text  {cmd}\,\hat  {r}$ (\autoref {eq:ur-pursuit}) points along it, while the body velocity $\vec  {u}^*$ lags behind (tail chase, the prey moving along $+\hat  {x}$). The velocity error $\vec  {u}^*_r - \vec  {u}^*$ closes the velocity triangle, and the force demand of \autoref {eq:fdes} composes, tip to tail, the weight compensation $\hat  {z}$ with the amplified error $K (\vec  {u}^*_r - \vec  {u}^*)$. The wingbeat overlay is drawn as in \autoref {fig:hover-beta-gamma}, at the blended stroke-plane angle of \autoref {eq:gamma-schedule} for the drawn $J \approx 0.2$ ($\gamma \approx -60^\circ $, $\psi _1 = \psi _1^\text  {opt}(J)$); velocity and force arrow lengths are schematic.}}{25}{figure.caption.21}\protected@file@percent }
\newlabel{fig:pursuit-diagram}{{17}{25}{Control-law geometry in the prey pursuit use case. The prey is detected at the line-of-sight bearing $\hat {r}$ (sparse dots), and the reference velocity $\vec {u}^*_r = u^*_\text {cmd}\,\hat {r}$ (\autoref {eq:ur-pursuit}) points along it, while the body velocity $\vec {u}^*$ lags behind (tail chase, the prey moving along $+\hat {x}$). The velocity error $\vec {u}^*_r - \vec {u}^*$ closes the velocity triangle, and the force demand of \autoref {eq:fdes} composes, tip to tail, the weight compensation $\hat {z}$ with the amplified error $K (\vec {u}^*_r - \vec {u}^*)$. The wingbeat overlay is drawn as in \autoref {fig:hover-beta-gamma}, at the blended stroke-plane angle of \autoref {eq:gamma-schedule} for the drawn $J \approx 0.2$ ($\gamma \approx -60^\circ $, $\psi _1 = \psi _1^\text {opt}(J)$); velocity and force arrow lengths are schematic}{figure.caption.21}{}}
\newlabel{eq:psi1-slave}{{91}{25}{Control Law}{equation.91}{}}
\newlabel{eq:trim}{{92}{25}{Control Law}{equation.92}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Stroke-plane schedule (\autoref {eq:gamma-schedule}) in level flight toward $+\hat  {x}$ ($\sigma _x = +1$), at increasing advance ratio. At rest (left), the stroke plane holds the inclined-hover lean $\sigma _x \gamma ^\text  {hover}$; as the forward speed builds (middle, right), the blend leans it toward the velocity-aligned value $\gamma _u$, at which the stroke-plane normal $\hat  {n}$ points along the flight direction and the inflow is axial. The wingbeat overlay is drawn as in \autoref {fig:hover-beta-gamma}, with $\psi _1 = \psi _1^\text  {opt}(J)$; the mean pitch and the velocity arrow lengths are schematic.}}{26}{figure.caption.22}\protected@file@percent }
\newlabel{fig:gamma-schedule-level}{{18}{26}{Stroke-plane schedule (\autoref {eq:gamma-schedule}) in level flight toward $+\hat {x}$ ($\sigma _x = +1$), at increasing advance ratio. At rest (left), the stroke plane holds the inclined-hover lean $\sigma _x \gamma ^\text {hover}$; as the forward speed builds (middle, right), the blend leans it toward the velocity-aligned value $\gamma _u$, at which the stroke-plane normal $\hat {n}$ points along the flight direction and the inflow is axial. The wingbeat overlay is drawn as in \autoref {fig:hover-beta-gamma}, with $\psi _1 = \psi _1^\text {opt}(J)$; the mean pitch and the velocity arrow lengths are schematic}{figure.caption.22}{}}
