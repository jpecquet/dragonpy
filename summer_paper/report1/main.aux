\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Force coefficient $C_{F^*}$ over the pitch plane $(\psi _0, \psi _1)$ at $\delta _0 = 90^\circ $, for increasing advance ratio $J$. White dots track the hover optimum as it moves with $J$. It remains on the $\psi _0 = 0^\circ $ axis by symmetry while $\psi _1$ decreases, and it turns from a local maximum into a saddle point. The global maximum sits at large $|\psi _0|$, where the force is dominated by drag from the normal inflow and points along $-\hat  {n}$. The dotted contour marks $C_{F^*_n} = 0$, the boundary between propulsive ($+\hat  {n}$) and braking ($-\hat  {n}$) mean force.}}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cf_J}{{11}{17}{Force coefficient $C_{F^*}$ over the pitch plane $(\psi _0, \psi _1)$ at $\delta _0 = 90^\circ $, for increasing advance ratio $J$. White dots track the hover optimum as it moves with $J$. It remains on the $\psi _0 = 0^\circ $ axis by symmetry while $\psi _1$ decreases, and it turns from a local maximum into a saddle point. The global maximum sits at large $|\psi _0|$, where the force is dominated by drag from the normal inflow and points along $-\hat {n}$. The dotted contour marks $C_{F^*_n} = 0$, the boundary between propulsive ($+\hat {n}$) and braking ($-\hat {n}$) mean force}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Wing kinematic parameters (general case)}}{17}{table.caption.16}\protected@file@percent }
