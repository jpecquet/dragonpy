\citation{andersen2005}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Lumped wing velocity triangle and aerodynamic force. The wing velocity relative to the air, $\vec  {v} = \vec  {\dot  {s}} + \vec  {u}$, composes the flapping velocity $\vec  {\dot  {s}} = \dot  {s}\,\hat  {s}$ (along the stroke axis, dotted) with the body velocity $\vec  {u}$. The angle of attack $\alpha $ is the signed angle from $\hat  {v}$ to the chord direction $\hat  {c}$, with $\hat  {p} = \hat  {c}^\perp $ the chord-normal direction, and the lift and drag contributions are drawn along $\hat  {\ell }$ and $\hat  {d}$ with lengths proportional to $C_L$ and $C_D$ (here $0 < \alpha < \frac  {\pi }{2}$, so $C_L > 0$).}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:velocity-triangle}{{2}{4}{Lumped wing velocity triangle and aerodynamic force. The wing velocity relative to the air, $\vec {v} = \vec {\dot {s}} + \vec {u}$, composes the flapping velocity $\vec {\dot {s}} = \dot {s}\,\hat {s}$ (along the stroke axis, dotted) with the body velocity $\vec {u}$. The angle of attack $\alpha $ is the signed angle from $\hat {v}$ to the chord direction $\hat {c}$, with $\hat {p} = \hat {c}^\perp $ the chord-normal direction, and the lift and drag contributions are drawn along $\hat {\ell }$ and $\hat {d}$ with lengths proportional to $C_L$ and $C_D$ (here $0 < \alpha < \frac {\pi }{2}$, so $C_L > 0$)}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Prescribed Wing Kinematics}{4}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Lift and drag directions in the four quadrants of the angle of attack $\alpha $, measured from the wing velocity direction $\hat  {v}$ to the chord direction $\hat  {c}$. Panels are labeled by quadrant (I--IV). Drag ($C_D > 0$) always opposes the wing velocity along $\hat  {d}$, while the sign of $C_L$ orients lift along $\pm \hat  {\ell }$. The hollow circle marks the wing leading edge (the $\hat  {c}$ end of the chord).}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:liftdrag-quadrants}{{3}{5}{Lift and drag directions in the four quadrants of the angle of attack $\alpha $, measured from the wing velocity direction $\hat {v}$ to the chord direction $\hat {c}$. Panels are labeled by quadrant (I--IV). Drag ($C_D > 0$) always opposes the wing velocity along $\hat {d}$, while the sign of $C_L$ orients lift along $\pm \hat {\ell }$. The hollow circle marks the wing leading edge (the $\hat {c}$ end of the chord)}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Wing motion through the two halves of the flapping cycle, for the sinusoidal pitch kinematics with $\delta _0 \in \{0, \frac  {\pi }{2}, -\frac  {\pi }{2}, \pi \}$ and for the constant-pitch simplification. Across all panels, $\psi _0 = 0$ and $\psi _1 = 45^\circ $. The top row shows the half-stroke along $+\hat  {s}$ (with $\hat  {s}$ pointing right) and the bottom row the half-stroke along $-\hat  {s}$. Arrows indicate the direction of motion, the hollow circle marks the wing leading edge, and snapshots are taken at equal time increments, crowding near the stroke reversals where the flapping motion slows. The constant-pitch kinematics match the $\delta _0 = \pi /2$ kinematics well, except near stroke reversal.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pitch-kinematics}{{4}{6}{Wing motion through the two halves of the flapping cycle, for the sinusoidal pitch kinematics with $\delta _0 \in \{0, \frac {\pi }{2}, -\frac {\pi }{2}, \pi \}$ and for the constant-pitch simplification. Across all panels, $\psi _0 = 0$ and $\psi _1 = 45^\circ $. The top row shows the half-stroke along $+\hat {s}$ (with $\hat {s}$ pointing right) and the bottom row the half-stroke along $-\hat {s}$. Arrows indicate the direction of motion, the hollow circle marks the wing leading edge, and snapshots are taken at equal time increments, crowding near the stroke reversals where the flapping motion slows. The constant-pitch kinematics match the $\delta _0 = \pi /2$ kinematics well, except near stroke reversal}{figure.caption.5}{}}
